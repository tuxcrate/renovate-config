{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Versioning support for Tuxcrate container images",
  "packageRules": [
    {
      "description": "Treat Tuxcrate image revisions as patch updates",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/tuxcrate/**"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-r(?<revision>\\d+)$"
    }
  ]
}
