{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared dependency update policy for all Tuxcrate repositories",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Automerge non-major updates after required checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Assign major updates for review",
      "matchUpdateTypes": ["major"],
      "assignees": ["Skaronator"]
    }
  ],
  "semanticCommits": "enabled"
}
